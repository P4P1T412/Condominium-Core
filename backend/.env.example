# Oracle local (Docker Compose)
DB_USER=condominio_app
DB_PASSWORD=change-this-local-db-password
DB_CONNECTION_STRING=localhost:1521/FREEPDB1
ORACLE_SYS_PASSWORD=change-this-oracle-sys-password
ORACLE_PORT=1521

# Backend y sesión
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP opcional. Si no se configura, el servicio trabaja en modo simulación.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_SERVICE=

# Twilio WhatsApp opcional. Si no se configura, el servicio trabaja en modo simulación.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=
